<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>judgekit · {{ result.suite_name }}</title>
<style>
  :root {
    --bg: #f7f7f5; --card: #ffffff; --ink: #1f1f1e; --muted: #6b6b68; --rule: #e4e4e0;
    --good: #0ca30c; --good-track: #d7f0d7;
    --critical: #d03b3b; --critical-track: #f6dada;
    --neutral: #7c8795; --neutral-track: #e6e9ed;
    --marker: #1f1f1e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --bg: #121211; --card: #1a1a19; --ink: #ececea; --muted: #a3a3a0; --rule: #2e2e2c;
      --good-track: #1d3a1d; --critical-track: #45201f; --neutral-track: #2b3036;
      --marker: #ececea;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 32px 16px; background: var(--bg); color: var(--ink);
         font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1040px; margin: 0 auto; }
  h1 { font-size: 22px; margin: 0; }
  h2 { font-size: 16px; margin: 32px 0 12px; }
  .meta { color: var(--muted); margin: 4px 0 20px; }
  .badge { display: inline-flex; gap: 6px; align-items: center; font-weight: 600;
           padding: 4px 10px; border-radius: 999px; border: 1px solid var(--rule); background: var(--card); }
  .icon-good { color: var(--good); } .icon-critical { color: var(--critical); }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .tile { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; padding: 14px 16px; }
  .tile .label { color: var(--muted); font-size: 12px; }
  .tile .value { font-size: 24px; font-weight: 600; }
  .tile .sub { color: var(--muted); font-size: 12px; }
  .card { background: var(--card); border: 1px solid var(--rule); border-radius: 8px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; font-size: 12px; }
  tr:last-child td { border-bottom: none; }
  td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kind { color: var(--muted); font-size: 12px; }
  /* Meter: fill = status colour, track = lighter step of the same hue, marker = threshold. */
  .meter { position: relative; height: 10px; min-width: 160px; border-radius: 4px; }
  .meter .fill { height: 100%; border-radius: 0 4px 4px 0; }
  .meter.ok { background: var(--good-track); } .meter.ok .fill { background: var(--good); }
  .meter.bad { background: var(--critical-track); } .meter.bad .fill { background: var(--critical); }
  .meter.none { background: var(--neutral-track); } .meter.none .fill { background: var(--neutral); }
  .meter .marker { position: absolute; top: -4px; width: 2px; height: 18px; margin-left: -1px;
                   background: var(--marker); }
  .case { padding: 14px 16px; border-bottom: 1px solid var(--rule); }
  .case:last-child { border-bottom: none; }
  .case h3 { font-size: 14px; margin: 0 0 8px; font-family: ui-monospace, Menlo, monospace; }
  .field { color: var(--muted); font-size: 12px; margin-top: 8px; }
  .text { white-space: pre-wrap; overflow-wrap: anywhere; margin: 2px 0 0; }
  ul.failures { margin: 8px 0 0; padding-left: 18px; }
  details summary { cursor: pointer; color: var(--muted); font-size: 12px; margin-top: 8px; }
  footer { color: var(--muted); font-size: 12px; margin-top: 32px; }
  code { font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
</style>
</head>
<body>
<main>

<header>
  <h1>{{ result.suite_name }}</h1>
  <p class="meta">judgekit {{ version }} · generated {{ generated_at }}</p>
  {% if result.passed %}
  <span class="badge"><span class="icon-good" aria-hidden="true">✓</span> Passed: every scorer met its threshold</span>
  {% else %}
  {% set below = result.summaries | rejectattr("meets_threshold") | list %}
  <span class="badge"><span class="icon-critical" aria-hidden="true">✗</span> Failed: {{ below | length }} scorer{{ "s" if below | length != 1 }} below threshold</span>
  {% endif %}
</header>

<h2>Summary</h2>
<section class="tiles">
  <div class="tile">
    <div class="label">Cases</div>
    <div class="value">{{ result.cases | length }}</div>
    <div class="sub">{{ failed_cases | length }} with at least one failure</div>
  </div>
  <div class="tile">
    <div class="label">Total time</div>
    <div class="value">{{ "%.1f" | format(result.total_latency_ms / 1000) }} s</div>
    <div class="sub">wall clock, parallel run</div>
  </div>
  <div class="tile">
    <div class="label">Model tokens</div>
    <div class="value">{{ "{:,}".format(usages | sum(attribute="input_tokens") + usages | sum(attribute="output_tokens")) }}</div>
    <div class="sub">{{ "{:,}".format(usages | sum(attribute="input_tokens")) }} in · {{ "{:,}".format(usages | sum(attribute="output_tokens")) }} out</div>
  </div>
  <div class="tile">
    <div class="label">Estimated cost</div>
    {% if total_cost is not none %}
    <div class="value">${{ "%.4f" | format(total_cost) }}</div>
    <div class="sub">tokens × suite pricing</div>
    {% else %}
    <div class="value">not configured</div>
    <div class="sub">add <code>pricing</code> to the suite YAML</div>
    {% endif %}
  </div>
</section>

<h2>Pass rate by scorer</h2>
<div class="card">
<table>
  <thead>
    <tr><th>Scorer</th><th>Pass rate vs threshold</th><th>Passed</th><th>Threshold</th><th>Status</th></tr>
  </thead>
  <tbody>
  {% for s in result.summaries %}
    {% set pct = s.pass_rate * 100 %}
    {% set state = "none" if s.threshold is none else ("ok" if s.meets_threshold else "bad") %}
    <tr>
      <td>{{ s.name }}<div class="kind">{{ "LLM judge" if s.name in judge_names else "check" }}</div></td>
      <td>
        <div class="meter {{ state }}" role="img"
             aria-label="{{ '%.1f' | format(pct) }}% passed{% if s.threshold is not none %}, threshold {{ '%.1f' | format(s.threshold * 100) }}%{% endif %}"
             title="{{ '%.1f' | format(pct) }}% passed{% if s.threshold is not none %} · threshold {{ '%.1f' | format(s.threshold * 100) }}%{% endif %}">
          <div class="fill" style="width: {{ '%.2f' | format(pct) }}%"></div>
          {% if s.threshold is not none %}
          <div class="marker" style="left: {{ '%.2f' | format(s.threshold * 100) }}%"></div>
          {% endif %}
        </div>
      </td>
      <td class="num">{{ "%.1f" | format(pct) }}% ({{ s.passed }}/{{ s.total }})</td>
      <td class="num">{{ "%.1f%%" | format(s.threshold * 100) if s.threshold is not none else "none" }}</td>
      <td>
        {% if state == "ok" %}<span class="icon-good" aria-hidden="true">✓</span> ok
        {% elif state == "bad" %}<span class="icon-critical" aria-hidden="true">✗</span> below threshold
        {% else %}<span aria-hidden="true">–</span> reported only{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2>Failed cases ({{ failed_cases | length }})</h2>
{% if failed_cases %}
<div class="card">
  {% for cr in failed_cases %}
  <article class="case">
    <h3>{{ cr.case.id }}</h3>
    <ul class="failures">
      {% for r in cr.results if not r.passed %}
      <li><strong>{{ r.judge }}</strong>: {{ r.reason }}</li>
      {% endfor %}
    </ul>
    <div class="field">Input</div>
    <p class="text">{{ cr.case.input }}</p>
    <div class="field">Output</div>
    <p class="text">{{ cr.output if cr.output else "(no output)" }}</p>
    {% if cr.case.context %}
    <details><summary>Context</summary><p class="text">{{ cr.case.context }}</p></details>
    {% endif %}
  </article>
  {% endfor %}
</div>
{% else %}
<p class="meta">No failures.</p>
{% endif %}

{% if usages %}
<h2>Model usage</h2>
<div class="card">
<table>
  <thead><tr><th>Role</th><th>Model</th><th>Input tokens</th><th>Output tokens</th><th>Estimated cost</th></tr></thead>
  <tbody>
  {% for u in usages %}
    <tr>
      <td>{{ u.role }}</td>
      <td><code>{{ u.model_id }}</code></td>
      <td class="num">{{ "{:,}".format(u.input_tokens) }}</td>
      <td class="num">{{ "{:,}".format(u.output_tokens) }}</td>
      <td class="num">{{ "$%.4f" | format(u.cost_usd) if u.cost_usd is not none else "no pricing" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<footer>
  Cost is an estimate: token counts reported by Bedrock × the per-model prices in the suite's
  <code>pricing</code> section. Check them against the AWS Bedrock pricing page.
</footer>

</main>
</body>
</html>
